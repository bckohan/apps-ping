{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Starts the apps-ping GitHub workflow every hour, because GitHub's own
  // schedule is best effort and often skips runs.
  "name": "apps-ping-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // No HTTP endpoint, this Worker only runs on its cron trigger.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "vars": {
    "GITHUB_REPO": "bckohan/apps-ping",
    "GITHUB_WORKFLOW": "ping.yml",
    "GITHUB_REF": "main",
    "NTFY_TOPIC": "apps-ping-usn8"
  },
  // GITHUB_TOKEN is a secret: a fine-grained token with Actions read/write on
  // the repository above. Set it with `npx wrangler secret put GITHUB_TOKEN`.
  "observability": {
    "enabled": true
  }
}
